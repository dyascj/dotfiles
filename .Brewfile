tap "nikitabobko/tap"
tap "anomalyco/tap"

# Shell & terminal
brew "powerlevel10k"
brew "zsh-autosuggestions"
brew "eza"
brew "fzf"

# Dev tools
brew "git"
brew "gh"
brew "glab"
brew "lazygit"
brew "vim"
brew "yadm"
brew "cmake"
brew "make"
brew "wget"
brew "actionlint"
brew "gitleaks"
brew "railway"

# AI CLIs
brew "gemini-cli"
brew "anomalyco/tap/opencode"
brew "ollama"

# Languages & runtimes
brew "node"
brew "pnpm"
brew "go"
brew "rust"
brew "pyenv"

# Containers & data
brew "colima"
brew "docker"
brew "docker-compose"
brew "postgresql@16"

# Media
brew "ffmpeg"
brew "imagemagick"
brew "gifsicle"
brew "poppler"
brew "woff2"

# System & monitoring
brew "btop"
brew "neofetch"
brew "coreutils"
brew "osx-cpu-temp"
brew "defaultbrowser"
brew "duti"

# Fun
brew "asciiquarium"
brew "nethack"

# Apps
cask "ghostty"
cask "zen"
cask "zed"
cask "visual-studio-code"
cask "codex"
cask "nikitabobko/tap/aerospace"
cask "sol"
cask "stats"
cask "tiled"

# Fonts
cask "font-hack-nerd-font"
