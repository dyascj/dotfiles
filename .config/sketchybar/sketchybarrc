#!/bin/bash

########################################
# Ash on the menu bar
# a floating strip of black glass, grey ramp, white for whatever is active
########################################

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/helpers/ash.sh"
rm -f "$MENU_STATE" # every menu starts closed

# The Control Center helper builds from source the first time, and again when it changes
if [ "$CONFIG_DIR/helpers/ccctl.swift" -nt "$CCCTL" ]; then
  mkdir -p "$(dirname "$CCCTL")"
  swiftc -O "$CONFIG_DIR/helpers/ccctl.swift" -o "$CCCTL" \
    -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist \
    -Xlinker "$CONFIG_DIR/helpers/ccctl-Info.plist" &&
    codesign -f -s - -i local.sketchybar.ccctl "$CCCTL"
fi

# topmost keeps the bar above the real menu bar, which still slides down
# when the mouse reaches the top of the screen
sketchybar --bar position=top height=32 margin=10 y_offset=6 corner_radius=12 \
  color=0xa6000000 blur_radius=30 border_width=1 border_color=$HAIRLINE \
  shadow=off notch_width=200 padding_left=6 padding_right=6 topmost=on

sketchybar --default updates=when_shown \
  icon.font="Hack Nerd Font:Regular:14.0" icon.color=$DIM \
  label.font="SF Mono:Medium:12.0" label.color=$TEXT \
  icon.padding_left=4 icon.padding_right=4 \
  label.padding_left=4 label.padding_right=4 \
  padding_left=2 padding_right=2

# left: the Apple menu, workspaces, the layout menu, then the app in front

sketchybar --add item apple left \
  --set apple icon= icon.color=$TEXT label.drawing=off padding_right=4 \
    "${MENU_BUTTON[@]}" "${POPUP[@]}" script="$PLUGIN_DIR/apple.sh" \
  --subscribe apple mouse.clicked mouse.entered mouse.exited mouse.exited.global

menu_sep apple apple.top $CLEAR
menu_row apple apple.about "About This Mac" "" "$PLUGIN_DIR/apple.sh about"
menu_sep apple apple.sep1
menu_row apple apple.settings "System Settings…" "" "$PLUGIN_DIR/apple.sh settings"
menu_row apple apple.appstore "App Store…" "" "$PLUGIN_DIR/apple.sh appstore"
menu_sep apple apple.sep2
menu_row apple apple.forcequit "Force Quit…" "⌥⌘⎋" "$PLUGIN_DIR/apple.sh forcequit"
menu_sep apple apple.sep3
menu_row apple apple.sleep "Sleep" "" "$PLUGIN_DIR/apple.sh sleep"
menu_row apple apple.restart "Restart…" "" "$PLUGIN_DIR/apple.sh restart"
menu_row apple apple.shutdown "Shut Down…" "" "$PLUGIN_DIR/apple.sh shutdown"
menu_sep apple apple.sep4
menu_row apple apple.lock "Lock Screen" "⌃⌘Q" "$PLUGIN_DIR/apple.sh lock"
menu_row apple apple.logout "Log Out $(id -F)…" "⇧⌘Q" "$PLUGIN_DIR/apple.sh logout"
menu_sep apple apple.bottom $CLEAR

# AeroSpace workspaces: click one to go there, right-click to send the window
# there. Each lists its apps, the focused one gets the 10% wash, and the
# rest fade in the 5% one under the mouse.
sketchybar --add event aerospace_change

for sid in 1 2 3 4 5; do
  sketchybar --add item space.$sid left \
    --set space.$sid icon=$sid \
      icon.font="SF Mono:Semibold:12.0" icon.color=$DIM \
      icon.padding_left=8 icon.padding_right=8 \
      label.font="sketchybar-app-font:Regular:13.0" label.color=$DIM \
      label.padding_left=0 label.padding_right=8 label.y_offset=-1 label.drawing=off \
      background.color=$CLEAR background.corner_radius=7 background.height=22 background.drawing=on \
      script="$PLUGIN_DIR/bar_hover.sh" \
      click_script="if [ \"\$BUTTON\" = right ]; then aerospace move-node-to-workspace --focus-follows-window $sid; else aerospace workspace $sid; fi" \
    --subscribe space.$sid mouse.entered mouse.exited
done

sketchybar --add item workspaces left \
  --set workspaces drawing=off updates=on script="$PLUGIN_DIR/aerospace.sh" \
  --subscribe workspaces aerospace_change front_app_switched space_windows_change system_woke

# Tiling or free, and the few window commands worth knowing, with their shortcuts
sketchybar --add item layout left \
  --set layout icon=󰕰 icon.color=$TEXT label.drawing=off padding_left=4 \
    "${MENU_BUTTON[@]}" "${POPUP[@]}" script="$PLUGIN_DIR/popup.sh" \
  --subscribe layout mouse.clicked mouse.entered mouse.exited mouse.exited.global

close="\"$PLUGIN_DIR/popup.sh\" close layout"
menu_sep layout layout.top $CLEAR
menu_row layout layout.mode "Free mode" "⌥T" "$close; ~/.config/aerospace/mode.sh toggle"
menu_sep layout layout.sep1
menu_row layout layout.float "Float this window" "⌥F" "$close; aerospace layout floating tiling"
menu_row layout layout.full "Fullscreen" "⌥↩" "$close; aerospace fullscreen"
menu_row layout layout.flip "Flip layout" "⌥/" "$close; aerospace layout tiles horizontal vertical"
menu_row layout layout.tidy "Tidy up" "⌥=" "$close; ~/.config/aerospace/mode.sh tidy"
menu_sep layout layout.sep2
menu_row layout layout.move "Move window" "⌃⌥ arrows" "$close"
menu_row layout layout.send "Send to workspace" "⌥⇧1-5" "$close"
menu_row layout layout.last "Last workspace" "⌥⇥" "$close; aerospace workspace-back-and-forth"
menu_sep layout layout.bottom $CLEAR

sketchybar --add item divider left \
  --set divider width=1 icon.drawing=off label.drawing=off padding_left=8 padding_right=8 \
    background.color=0x26ffffff background.height=14 background.drawing=on

sketchybar --add item front_app left \
  --set front_app icon.font="sketchybar-app-font:Regular:14.0" icon.color=$TEXT \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# right, added outside in: clock, Control Center, battery, volume, cpu, Tailscale, Vorssaint

sketchybar --add item clock right \
  --set clock icon.drawing=off update_freq=15 padding_left=8 \
    script='sketchybar --set $NAME label="$(date "+%a %-I:%M %p")"' \
  --subscribe clock system_woke

sketchybar --add item control_center right \
  --set control_center icon= icon.color=$TEXT label.drawing=off \
    "${MENU_BUTTON[@]}" "${POPUP[@]}" popup.align=right script="$PLUGIN_DIR/control_center.sh" \
  --subscribe control_center mouse.clicked mouse.entered mouse.exited mouse.exited.global

cc="$PLUGIN_DIR/control_center.sh"
menu_sep control_center cc.top $CLEAR
menu_row control_center cc.wifi "Wi-Fi" "" "\"$cc\" wifi"
menu_row control_center cc.bluetooth "Bluetooth" "" "\"$cc\" bluetooth"
menu_row control_center cc.airdrop "AirDrop" "" "\"$cc\" airdrop"
menu_row control_center cc.focus "Focus" "" "\"$cc\" focus"
# The switches draw with the Nerd Font
for row in cc.wifi cc.bluetooth cc.airdrop; do
  sketchybar --set $row label.font="Hack Nerd Font:Regular:16.0"
done
menu_sep control_center cc.sep1

slider() { # name
  sketchybar --add slider "$1" popup.control_center $((MENU_WIDTH - 32)) \
    --set "$1" padding_left=16 padding_right=16 icon.drawing=off label.drawing=off \
      slider.background.height=4 slider.background.corner_radius=2 \
      slider.background.color=0x26ffffff slider.highlight_color=$TEXT \
      slider.knob.drawing=off background.height=20 script="$cc"
}
# A brightness slider per display, for up to three; unused rows stay hidden
for n in 1 2 3; do
  menu_label control_center cc.display$n "Display"
  slider cc.brightness$n
  sketchybar --set cc.display$n drawing=off --set cc.brightness$n drawing=off \
    --subscribe cc.brightness$n mouse.clicked
done
menu_label control_center cc.sound "Sound"
slider cc.volume
sketchybar --subscribe cc.volume mouse.clicked volume_change
# Sound outputs, Now Playing, Dark Mode, Capture Screen and Screen Mirroring
# are added below these by the plugin

sketchybar --add item battery right \
  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery power_source_change system_woke

# Clicking the volume opens Control Center, like Apple's Sound menu
sketchybar --add item volume right \
  --set volume script="$PLUGIN_DIR/volume.sh" click_script="$PLUGIN_DIR/control_center.sh" \
    background.color=$CLEAR background.height=24 background.corner_radius=7 background.drawing=on \
  --subscribe volume volume_change mouse.entered mouse.exited

sketchybar --add item cpu right \
  --set cpu icon= update_freq=5 script="$PLUGIN_DIR/cpu.sh"

if [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]; then
  sketchybar --add item tailscale right \
    --set tailscale icon=󱗼 label.drawing=off update_freq=30 \
      "${MENU_BUTTON[@]}" "${POPUP[@]}" popup.align=right script="$PLUGIN_DIR/tailscale.sh" \
    --subscribe tailscale mouse.clicked mouse.entered mouse.exited mouse.exited.global system_woke

  menu_sep tailscale tailscale.top $CLEAR
  menu_row tailscale tailscale.power "Tailscale" "" "\"$PLUGIN_DIR/tailscale.sh\" power"
  menu_row tailscale tailscale.self "This Mac" "" "\"$PLUGIN_DIR/tailscale.sh\" copy \$(/Applications/Tailscale.app/Contents/MacOS/Tailscale ip -4)"
  menu_sep tailscale tailscale.sep1
  # your devices, the exit node and the rest are added by the plugin when it opens
fi

# Vorssaint's own panel, opened by clicking its hidden menu bar icon.
# That takes Accessibility for sketchybar; without it, opening the app is the fallback.
if [ -d /Applications/Vorssaint.app ]; then
  sketchybar --add item vorssaint right \
    --set vorssaint icon.drawing=off label.drawing=off width=24 \
      background.image="$CONFIG_DIR/assets/vorssaint.png" background.image.scale=0.4 \
      background.color=$CLEAR background.drawing=on \
      click_script="osascript -e 'tell application \"System Events\" to tell process \"Vorssaint\" to click menu bar item 1 of menu bar 2' || open -a Vorssaint"
fi

sketchybar --update
