#!/bin/bash
set -e

echo "==> Starting yadm bootstrap..."

# Install Homebrew if missing
if ! command -v brew &>/dev/null; then
    echo "==> Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Install packages from Brewfile
echo "==> Installing Homebrew packages..."
# One failed package shouldn't stop the rest of the setup
brew bundle --global || echo "==> Some Homebrew packages failed, rerun 'brew bundle --global' later"

# Ghostty uses SF Mono, which macOS only ships inside Terminal.app
SF_MONO_SRC="/System/Applications/Utilities/Terminal.app/Contents/Resources/Fonts"
if [ -d "$SF_MONO_SRC" ] && ! ls "$HOME/Library/Fonts"/SF-Mono-* &>/dev/null; then
    echo "==> Installing SF Mono..."
    cp "$SF_MONO_SRC"/SF-Mono-*.otf "$HOME/Library/Fonts/"
fi

# Install VS Code extensions
VSCODE_EXT_LIST="$HOME/.config/yadm/vscode-extensions.txt"
VSCODE_BIN="/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
if [ -x "$VSCODE_BIN" ] && [ -f "$VSCODE_EXT_LIST" ]; then
    echo "==> Installing VS Code extensions..."
    while IFS= read -r extension; do
        [ -n "$extension" ] && "$VSCODE_BIN" --install-extension "$extension" --force
    done < "$VSCODE_EXT_LIST"
else
    echo "==> Skipping VS Code extensions (VS Code not found or extension list missing)"
fi

# Set zsh as default shell if needed
if [ "$SHELL" != "$(which zsh)" ]; then
    echo "==> Setting zsh as default shell..."
    chsh -s "$(which zsh)"
fi

# Link zen userChrome into the default profile (profile dir name is machine-specific)
ZEN_DIR="$HOME/Library/Application Support/zen"
ZEN_CSS="$HOME/.config/zen/chrome/userChrome.css"
if [ -f "$ZEN_DIR/profiles.ini" ] && [ -f "$ZEN_CSS" ]; then
    ZEN_PROFILE=$(awk -F= '/^\[Install/{f=1} f && /^Default=/{print $2; exit}' "$ZEN_DIR/profiles.ini")
    if [ -n "$ZEN_PROFILE" ] && [ -d "$ZEN_DIR/$ZEN_PROFILE" ]; then
        echo "==> Linking zen userChrome into $ZEN_PROFILE..."
        mkdir -p "$ZEN_DIR/$ZEN_PROFILE/chrome"
        ln -sf "$ZEN_CSS" "$ZEN_DIR/$ZEN_PROFILE/chrome/userChrome.css"
        # userChrome.css only loads with the first pref. The rest make Zen's
        # glass read like T3's: acrylic url bar and compact sidebar, the clear
        # fullScreenUI material (2) instead of the heavy hudWindow (1), and no
        # greying out when the window loses focus. The last one lets web pages
        # be see-through, for the Zen Internet add-on.
        ZEN_USERJS="$ZEN_DIR/$ZEN_PROFILE/user.js"
        while read -r pref value; do
            touch "$ZEN_USERJS"
            sed -i '' "/\"$pref\"/d" "$ZEN_USERJS"
            echo "user_pref(\"$pref\", $value);" >> "$ZEN_USERJS"
        done <<'PREFS'
toolkit.legacyUserProfileCustomizations.stylesheets true
zen.theme.acrylic-urlbar true
zen.theme.acrylic-sidebar true
zen.widget.macos.window-material 2
zen.view.grey-out-inactive-windows false
browser.tabs.allow_transparent_browser true
PREFS
    fi
else
    echo "==> Skipping zen theme (no profile yet, rerun bootstrap after first launch)"
fi

# T3 Code glass build: clone the fork and link its updater. The build takes
# a few minutes, so it's left for `t3-glass-update` to run by hand.
T3_REPO="$HOME/Developer/t3code-glass"
if [ ! -d "$T3_REPO" ]; then
    echo "==> Cloning the T3 Code glass fork..."
    if git clone -q -b glass https://github.com/dyascj/t3code.git "$T3_REPO"; then
        git -C "$T3_REPO" remote add upstream https://github.com/pingdotgg/t3code.git
    else
        echo "==> Couldn't clone the T3 fork, skipping"
    fi
fi
if [ -d "$T3_REPO" ]; then
    mkdir -p "$HOME/.local/bin"
    ln -sf "$T3_REPO/scripts/glass-update.sh" "$HOME/.local/bin/t3-glass-update"
    # T3's native resource monitor builds with a private Rust toolchain, so
    # Homebrew's Rust never has to change for it
    T3_RUST="$HOME/.t3-glass-rust"
    if [ ! -x "$T3_RUST/cargo/bin/cargo" ]; then
        echo "==> Installing T3's private Rust toolchain..."
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
            RUSTUP_HOME="$T3_RUST/rustup" CARGO_HOME="$T3_RUST/cargo" sh -s -- -y --no-modify-path >/dev/null ||
            echo "==> Rust toolchain install failed, rerun bootstrap later"
    fi
    echo "==> Run t3-glass-update to build and install T3 Code (glass)"
fi

# sketchybar stands in for the menu bar, so hide the real one and start it.
# Its first start also builds the Control Center helper, which takes a few seconds.
if command -v sketchybar &>/dev/null; then
    echo "==> Starting sketchybar..."
    osascript -e 'tell application "System Events" to set autohide menu bar of dock preferences to true' ||
        echo "==> Couldn't hide the menu bar, turn on auto-hide in Control Center settings"
    brew services start sketchybar >/dev/null || echo "==> sketchybar didn't start, run 'brew services start sketchybar'"
fi

# The focus border around the active window
if command -v borders &>/dev/null; then
    echo "==> Starting borders..."
    brew services start borders >/dev/null || echo "==> borders didn't start, run 'brew services start borders'"
fi

# Right Control acts as right Option, for keyboards without one. It runs at every login.
KEYMAP="$HOME/Library/LaunchAgents/local.keyboard.right-option.plist"
if [ -f "$KEYMAP" ]; then
    echo "==> Turning right Control into right Option..."
    launchctl bootstrap "gui/$(id -u)" "$KEYMAP" 2>/dev/null || launchctl kickstart "gui/$(id -u)/local.keyboard.right-option" || true
fi

# AeroSpace starts itself at login after this. It needs Accessibility before it works.
if [ -d /Applications/AeroSpace.app ]; then
    echo "==> Starting AeroSpace (allow it in Privacy & Security > Accessibility)..."
    open -a AeroSpace
fi

echo "==> Bootstrap complete!"
