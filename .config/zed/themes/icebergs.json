{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Icebergs",
  "author": "CJ Dyas",
  "themes": [
    {
      "name": "Icebergs",
      "appearance": "dark",
      "style": {
        "background.appearance": "blurred",
        "background": "#101a19d9",
        "surface.background": "#00000000",
        "elevated_surface.background": "#182422f2",

        "border": "#46605c",
        "border.variant": "#2e403d",
        "border.focused": "#d3a778",
        "border.selected": "#d3a778",
        "border.transparent": "#00000000",
        "border.disabled": "#243330",

        "element.background": "#18242200",
        "element.hover": "#2e403d66",
        "element.active": "#2e403daa",
        "element.selected": "#2e403daa",
        "element.disabled": "#18242200",
        "drop_target.background": "#85a5b533",

        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#2e403d55",
        "ghost_element.active": "#2e403d99",
        "ghost_element.selected": "#2e403d99",
        "ghost_element.disabled": "#00000000",

        "text": "#e8e0d4",
        "text.muted": "#9aaba7",
        "text.placeholder": "#6e8380",
        "text.disabled": "#6e8380",
        "text.accent": "#a2bfcd",

        "icon": "#d9d2c5",
