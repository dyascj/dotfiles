        "editor.highlighted_line.background": "#2e403d66",
        "editor.line_number": "#3f5350",
        "editor.active_line_number": "#d3a778",
        "editor.invisible": "#3f5350",
        "editor.wrap_guide": "#2e403d66",
        "editor.active_wrap_guide": "#2e403d",
        "editor.indent_guide": "#2e403d66",
        "editor.indent_guide_active": "#6e8380",
