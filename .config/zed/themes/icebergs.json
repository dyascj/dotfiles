          {
            "cursor": "#d3a778",
            "background": "#d3a778",
            "selection": "#2e403daa"
          },
          {
            "cursor": "#85a5b5",
            "background": "#85a5b5",
            "selection": "#85a5b544"
          },
          {
            "cursor": "#7fc0a8",
            "background": "#7fc0a8",
            "selection": "#7fc0a844"
          },
          {
            "cursor": "#bd8f95",
            "background": "#bd8f95",
            "selection": "#bd8f9544"
          },
          {
            "cursor": "#83b8b0",
            "background": "#83b8b0",
            "selection": "#83b8b044"
          },
          {
            "cursor": "#c76f5c",
            "background": "#c76f5c",
            "selection": "#c76f5c44"
          }
        ],

        "syntax": {
          "attribute": { "color": "#a2bfcd" },
          "boolean": { "color": "#d3a778" },
          "comment": { "color": "#6e8380", "font_style": "italic" },
          "comment.doc": { "color": "#83b8b0", "font_style": "italic" },
          "constant": { "color": "#d3a778" },
          "constructor": { "color": "#85a5b5" },
          "embedded": { "color": "#e8e0d4" },
          "emphasis": { "color": "#85a5b5", "font_style": "italic" },
          "emphasis.strong": { "color": "#d3a778", "font_weight": 700 },
          "enum": { "color": "#83b8b0" },
          "function": { "color": "#85a5b5" },
          "function.method": { "color": "#85a5b5" },
          "hint": { "color": "#5d827d", "font_style": "italic" },
          "keyword": { "color": "#bd8f95" },
          "label": { "color": "#a2bfcd" },
          "link_text": { "color": "#7fc0a8" },
          "link_uri": { "color": "#a2bfcd", "font_style": "italic" },
          "number": { "color": "#d3a778" },
          "operator": { "color": "#9aaba7" },
          "predictive": { "color": "#5d827d", "font_style": "italic" },
          "preproc": { "color": "#dc8a75" },
          "primary": { "color": "#e8e0d4" },
          "property": { "color": "#a2bfcd" },
          "punctuation": { "color": "#9aaba7" },
          "punctuation.bracket": { "color": "#9aaba7" },
          "punctuation.delimiter": { "color": "#9aaba7" },
          "punctuation.list_marker": { "color": "#c76f5c" },
          "punctuation.special": { "color": "#bd8f95" },
          "string": { "color": "#7fc0a8" },
          "string.escape": { "color": "#e5bd92" },
          "string.regex": { "color": "#a1d0c8" },
          "string.special": { "color": "#a1d0c8" },
          "string.special.symbol": { "color": "#a1d0c8" },
          "tag": { "color": "#c76f5c" },
          "text.literal": { "color": "#7fc0a8" },
          "title": { "color": "#d3a778", "font_weight": 700 },
          "type": { "color": "#83b8b0" },
          "variable": { "color": "#e8e0d4" },
          "variable.special": { "color": "#bd8f95" },
          "variant": { "color": "#83b8b0" }
