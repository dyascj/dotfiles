        "terminal.bright_foreground": "#f2ece1",
        "terminal.dim_foreground": "#9aaba7",
        "terminal.ansi.black": "#182422",
        "terminal.ansi.red": "#c76f5c",
        "terminal.ansi.green": "#63a68f",
