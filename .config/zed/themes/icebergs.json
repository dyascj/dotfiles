        "created.border": "#7fc0a855",
        "deleted": "#c76f5c",
        "deleted.background": "#c76f5c22",
        "deleted.border": "#c76f5c55",
        "error": "#dc8a75",
        "error.background": "#dc8a7522",
        "error.border": "#dc8a7555",
        "hidden": "#6e8380",
        "hidden.background": "#00000000",
        "hidden.border": "#2e403d",
        "hint": "#6e8380",
        "hint.background": "#00000000",
        "hint.border": "#2e403d",
        "ignored": "#6e8380",
        "ignored.background": "#00000000",
        "ignored.border": "#2e403d",
        "info": "#85a5b5",
        "info.background": "#85a5b522",
        "info.border": "#85a5b555",
        "modified": "#e5bd92",
        "modified.background": "#e5bd9222",
        "modified.border": "#e5bd9255",
        "predictive": "#5d827d",
        "predictive.background": "#00000000",
        "predictive.border": "#2e403d",
        "renamed": "#a2bfcd",
        "renamed.background": "#a2bfcd22",
        "renamed.border": "#a2bfcd55",
        "success": "#7fc0a8",
        "success.background": "#7fc0a822",
        "success.border": "#7fc0a855",
        "unreachable": "#6e8380",
