{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Voltage",
  "author": "CJ Dyas",
  "themes": [
    {
      "name": "Voltage",
      "appearance": "dark",
      "style": {
        "background.appearance": "blurred",
        "background": "#0a0a0ad9",
        "surface.background": "#00000000",
        "elevated_surface.background": "#171717f2",

        "border": "#262626",
        "border.variant": "#19283c",
        "border.focused": "#009fff",
        "border.selected": "#009fff",
        "border.transparent": "#00000000",
        "border.disabled": "#1d1d1d",

        "element.background": "#17171700",
        "element.hover": "#19283c66",
        "element.active": "#19283caa",
        "element.selected": "#19283caa",
        "element.disabled": "#17171700",
        "drop_target.background": "#009fff33",

        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#19283c55",
        "ghost_element.active": "#19283c99",
        "ghost_element.selected": "#19283c99",
        "ghost_element.disabled": "#00000000",

        "text": "#fafafa",
        "text.muted": "#a3a3a3",
        "text.placeholder": "#737373",
        "text.disabled": "#737373",
        "text.accent": "#9d6afb",

        "icon": "#a3a3a3",
        "icon.muted": "#a3a3a3",
        "icon.disabled": "#737373",
        "icon.placeholder": "#737373",
        "icon.accent": "#9d6afb",

        "title_bar.background": "#0a0a0ad9",
        "title_bar.inactive_background": "#0a0a0ad9",
        "status_bar.background": "#0a0a0ad9",
        "toolbar.background": "#00000000",
        "tab_bar.background": "#00000000",
        "tab.inactive_background": "#0a0a0a00",
        "tab.active_background": "#0a0a0a00",

        "search.match_background": "#009fff44",

        "panel.background": "#00000000",
        "panel.focused_border": "#009fff",
        "panel.indent_guide": "#19283c",
        "panel.indent_guide_active": "#737373",
        "panel.indent_guide_hover": "#009fff",

        "pane.focused_border": "#009fff",
        "pane_group.border": "#262626",

        "scrollbar.thumb.background": "#73737344",
        "scrollbar.thumb.hover_background": "#73737377",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "minimap.thumb.background": "#73737333",
        "minimap.thumb.hover_background": "#73737366",
        "minimap.thumb.border": "#00000000",

        "editor.foreground": "#fafafa",
        "editor.background": "#0a0a0a00",
        "editor.gutter.background": "#0a0a0a00",
        "editor.subheader.background": "#17171788",
        "editor.active_line.background": "#17171788",
        "editor.highlighted_line.background": "#19283c66",
        "editor.line_number": "#404040",
        "editor.active_line_number": "#009fff",
        "editor.invisible": "#404040",
        "editor.wrap_guide": "#19283c66",
        "editor.active_wrap_guide": "#19283c",
        "editor.indent_guide": "#19283c66",
        "editor.indent_guide_active": "#737373",
        "editor.document_highlight.read_background": "#009fff33",
        "editor.document_highlight.write_background": "#009fff33",
        "editor.document_highlight.bracket_background": "#08c0ef44",

        "terminal.background": "#0a0a0a00",
        "terminal.foreground": "#fafafa",
        "terminal.bright_foreground": "#fafafa",
        "terminal.dim_foreground": "#737373",
        "terminal.ansi.black": "#171717",
        "terminal.ansi.red": "#ff2e3f",
        "terminal.ansi.green": "#0dbe4e",
        "terminal.ansi.yellow": "#ffca00",
        "terminal.ansi.blue": "#009fff",
        "terminal.ansi.magenta": "#e130ac",
        "terminal.ansi.cyan": "#08c0ef",
        "terminal.ansi.white": "#bcbcbc",
        "terminal.ansi.bright_black": "#171717",
        "terminal.ansi.bright_red": "#ff2e3f",
        "terminal.ansi.bright_green": "#86c427",
        "terminal.ansi.bright_yellow": "#ffca00",
        "terminal.ansi.bright_blue": "#009fff",
        "terminal.ansi.bright_magenta": "#e130ac",
        "terminal.ansi.bright_cyan": "#08c0ef",
        "terminal.ansi.bright_white": "#bcbcbc",
        "terminal.ansi.dim_black": "#0a0a0a",
        "terminal.ansi.dim_red": "#a61e29",
        "terminal.ansi.dim_green": "#088a38",
        "terminal.ansi.dim_yellow": "#a68400",
        "terminal.ansi.dim_blue": "#0069a8",
        "terminal.ansi.dim_magenta": "#931f70",
        "terminal.ansi.dim_cyan": "#05809c",
        "terminal.ansi.dim_white": "#7a7a7a",

        "link_text.hover": "#9d6afb",

        "conflict": "#009fff",
        "conflict.background": "#009fff22",
        "conflict.border": "#009fff55",
        "created": "#5ecc71",
        "created.background": "#5ecc7122",
        "created.border": "#5ecc7155",
        "deleted": "#ff2e3f",
        "deleted.background": "#ff2e3f22",
        "deleted.border": "#ff2e3f55",
        "error": "#ff855e",
        "error.background": "#ff855e22",
        "error.border": "#ff855e55",
        "hidden": "#737373",
        "hidden.background": "#00000000",
        "hidden.border": "#19283c",
        "hint": "#737373",
        "hint.background": "#00000000",
        "hint.border": "#19283c",
        "ignored": "#737373",
        "ignored.background": "#00000000",
        "ignored.border": "#19283c",
        "info": "#009fff",
        "info.background": "#009fff22",
        "info.border": "#009fff55",
        "modified": "#ffd452",
        "modified.background": "#ffd45222",
        "modified.border": "#ffd45255",
        "predictive": "#636363",
        "predictive.background": "#00000000",
        "predictive.border": "#19283c",
        "renamed": "#9d6afb",
        "renamed.background": "#9d6afb22",
        "renamed.border": "#9d6afb55",
        "success": "#5ecc71",
        "success.background": "#5ecc7122",
        "success.border": "#5ecc7155",
        "unreachable": "#737373",
        "unreachable.background": "#00000000",
        "unreachable.border": "#19283c",
        "warning": "#009fff",
        "warning.background": "#009fff22",
        "warning.border": "#009fff55",

        "players": [
          {
            "cursor": "#009fff",
            "background": "#009fff",
            "selection": "#009fff4d"
          },
          {
            "cursor": "#009fff",
            "background": "#009fff",
            "selection": "#009fff44"
          },
          {
            "cursor": "#5ecc71",
            "background": "#5ecc71",
            "selection": "#5ecc7144"
          },
          {
            "cursor": "#ff678d",
            "background": "#ff678d",
            "selection": "#ff678d44"
          },
          {
            "cursor": "#08c0ef",
            "background": "#08c0ef",
            "selection": "#08c0ef44"
          },
          {
            "cursor": "#ff2e3f",
            "background": "#ff2e3f",
            "selection": "#ff2e3f44"
          }
        ],

        "syntax": {
          "attribute": { "color": "#60d199" },
          "boolean": { "color": "#68cdf2" },
          "comment": { "color": "#737373", "font_style": "italic" },
          "comment.doc": { "color": "#737373", "font_style": "italic" },
          "constant": { "color": "#ffd452" },
          "constructor": { "color": "#d568ea" },
          "embedded": { "color": "#fafafa" },
          "emphasis": { "color": "#ff678d", "font_style": "italic" },
          "emphasis.strong": { "color": "#ffd452", "font_weight": 700 },
          "enum": { "color": "#d568ea" },
          "function": { "color": "#9d6afb" },
          "function.method": { "color": "#9d6afb" },
          "hint": { "color": "#636363", "font_style": "italic" },
          "keyword": { "color": "#ff678d" },
          "label": { "color": "#9d6afb" },
          "link_text": { "color": "#9d6afb" },
          "link_uri": { "color": "#ff678d", "font_style": "italic" },
          "number": { "color": "#68cdf2" },
          "operator": { "color": "#08c0ef" },
          "predictive": { "color": "#636363", "font_style": "italic" },
          "preproc": { "color": "#ff678d" },
          "primary": { "color": "#fafafa" },
          "property": { "color": "#ffa359" },
          "punctuation": { "color": "#636363" },
          "punctuation.bracket": { "color": "#636363" },
          "punctuation.delimiter": { "color": "#636363" },
          "punctuation.list_marker": { "color": "#636363" },
          "punctuation.special": { "color": "#ff678d" },
          "string": { "color": "#5ecc71" },
          "string.escape": { "color": "#61d5c0" },
          "string.regex": { "color": "#64d1db" },
          "string.special": { "color": "#64d1db" },
          "string.special.symbol": { "color": "#5ecc71" },
          "tag": { "color": "#ff855e" },
          "text.literal": { "color": "#5ecc71" },
          "title": { "color": "#ff855e", "font_weight": 700 },
          "type": { "color": "#d568ea" },
          "variable": { "color": "#ffa359" },
          "variable.special": { "color": "#ffab16" },
          "variant": { "color": "#d568ea" }
        }
