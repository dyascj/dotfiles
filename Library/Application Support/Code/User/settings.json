        "sideBarSectionHeader.background": "#17171770",
        "activityBar.background": "#0a0a0a4d",
        "activityBar.foreground": "#fafafa",
        "activityBar.inactiveForeground": "#737373",
        "activityBar.border": "#19283c",
        "statusBar.background": "#17171780",
        "statusBar.border": "#19283c",
        "titleBar.activeBackground": "#17171770",
        "titleBar.inactiveBackground": "#17171770",
        "titleBar.border": "#19283c",
        "panel.background": "#0a0a0a00",
        "panel.border": "#19283c",
        "tab.activeBackground": "#0a0a0a00",
