        "menu.background": "#0a0a0ae6",
        "editorCursor.foreground": "#009fff",
        "editor.selectionBackground": "#19283c80",
        "editor.lineHighlightBackground": "#17171740",
        "focusBorder": "#0dbe4e80",
        "statusBar.foreground": "#a3a3a3",
