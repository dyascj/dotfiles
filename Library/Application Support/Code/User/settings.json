    "editor.tokenColorCustomizations": {
        "[Dark+]": {
            "comments": "#737373",
            "strings": "#5ecc71",
            "keywords": "#ff678d",
            "functions": "#9d6afb",
            "numbers": "#68cdf2",
            "types": "#d568ea",
            "variables": "#ffa359"
        }
    },
    "terminal.integrated.gpuAcceleration": "off",
    "window.systemColorTheme": "dark",
    "window.autoDetectColorScheme": false,
    "editor.accessibilitySupport": "off"
