<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Right Control becomes right Option at login, for keyboards like the Keychron
  K2 HE that have no right Option. The Mac's own keyboards have no right Control,
  so they're untouched. 0x7000000E4 is right Control, 0x7000000E6 right Option.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.keyboard.right-option</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/hidutil</string>
    <string>property</string>
    <string>--set</string>
    <string>{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x7000000E4,"HIDKeyboardModifierMappingDst":0x7000000E6}]}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
